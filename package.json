{
  "name": "@weave-framework/extra",
  "version": "0.1.0",
  "description": "Extras for Weave — additional components, component extensions and plugins built on @weave-framework/ui.",
  "type": "module",
  "sideEffects": [
    "./dist/components/**/*.js"
  ],
  "author": "Aidas Josas",
  "license": "MIT",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./components/split": {
      "types": "./src/components/split/split.ts",
      "import": "./src/components/split/split.ts"
    },
    "./components/split-pane": {
      "types": "./src/components/split/split-pane.ts",
      "import": "./src/components/split/split-pane.ts"
    },
    "./plugins/table": {
      "types": "./src/plugins/table/index.ts",
      "import": "./src/plugins/table/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "weave": {
    "//": "Component style language — a component's stylesheet is `<base>.<styleLang>` beside it. This lives here rather than in a weave.config.ts because that file must be app-shaped (it requires `root` or `entry`) and this package is a library. The build reads it, and any app in this repo (a demo, a test harness) must import it rather than restate it — the loader pairs styles by name with NO probing, so a mismatch means components render unstyled with nothing reporting it.",
    "styleLang": "scss"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weave-framework/weave-extra.git"
  },
  "keywords": [
    "weave",
    "reactive",
    "signals",
    "ui",
    "components",
    "plugins"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./components/split": {
        "types": "./dist/components/split/split.d.ts",
        "import": "./dist/components/split/split.js"
      },
      "./components/split-pane": {
        "types": "./dist/components/split/split-pane.d.ts",
        "import": "./dist/components/split/split-pane.js"
      },
      "./plugins/table": {
        "types": "./dist/plugins/table/index.d.ts",
        "import": "./dist/plugins/table/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node tools/build-components.mjs && tsc -p tsconfig.build.json",
    "examples": "node examples/tools/gen-snippets.mjs && weave dev --config examples/weave.config.ts",
    "examples:build": "node examples/tools/gen-snippets.mjs && weave build --config examples/weave.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "weave check",
    "verify:styles": "node tools/verify-styles.mjs",
    "verify:authorship": "node tools/verify-authorship.mjs"
  },
  "peerDependencies": {
    "@weave-framework/runtime": ">=2.2.0 <3",
    "@weave-framework/ui": ">=2.2.0 <3"
  },
  "devDependencies": {
    "@weave-framework/cli": "^2.2.0",
    "@weave-framework/compiler": "^2.2.0",
    "@weave-framework/runtime": "^2.2.0",
    "@weave-framework/ui": "^2.2.0",
    "sass": "^1.101.0",
    "typescript": "^5.7.0"
  }
}
