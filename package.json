{
  "name": "@weave-framework/extra",
  "version": "0.1.0",
  "description": "Extras for Weave — additional components, component extensions and plugins built on @weave-framework/ui.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/**/*.scss"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weave-framework/weave-extra.git"
  },
  "keywords": [
    "weave",
    "reactive",
    "signals",
    "ui",
    "components",
    "plugins"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:authorship": "node tools/verify-authorship.mjs"
  },
  "peerDependencies": {
    "@weave-framework/runtime": ">=2.1.0 <3",
    "@weave-framework/ui": ">=2.1.0 <3"
  },
  "devDependencies": {
    "@weave-framework/cli": "^2.1.0",
    "@weave-framework/runtime": "^2.1.0",
    "@weave-framework/ui": "^2.1.0",
    "sass": "^1.101.0",
    "typescript": "^5.7.0"
  }
}
